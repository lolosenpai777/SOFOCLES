PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# Resend is required to deliver verification codes and security emails.
RESEND_API_KEY=
MAIL_FROM=no-reply@example.com

# Legacy SMTP settings are retained only for local compatibility.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional. When provided, uploaded images are stored in Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/discord/callback

# Generate outside git with: npx @fastify/secure-session > secret-key
# Then set the base64/base64url key contents here.
OAUTH_SESSION_KEY=
